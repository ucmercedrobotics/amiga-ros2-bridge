<root BTCPP_format="4" schema_location="schemas/amiga_btcpp.xsd">
  <Mission>sample trees 96 and 102 in aisle 6</Mission>
  <BehaviorTree ID="SampleAisle6">
    <Sequence name="SampleAisle6Mission">
      <MoveToAisleHead name="EnterAisle6" action_name="move_to_aisle_head" id="6"/>
      <RetryUntilSuccessful name="SampleTree96WithRetry" num_attempts="3">
        <Sequence name="SampleTree96">
          <MoveToTreeID name="ApproachTree96" action_name="follow_tree_id_waypoint" id="96" approach_tree="true"/>
          <SampleLeaf name="SampleLeafTree96" action_name="segment_leaves"/>
        </Sequence>
      </RetryUntilSuccessful>
      <RetryUntilSuccessful name="SampleTree102WithRetry" num_attempts="3">
        <Sequence name="SampleTree102">
          <MoveToTreeID name="ApproachTree102" action_name="follow_tree_id_waypoint" id="102" approach_tree="true"/>
          <SampleLeaf name="SampleLeafTree102" action_name="segment_leaves"/>
        </Sequence>
      </RetryUntilSuccessful>
      <MoveToAisleHead name="ExitAisle6" action_name="move_to_aisle_head" id="6"/>
    </Sequence>
  </BehaviorTree>
</root>
