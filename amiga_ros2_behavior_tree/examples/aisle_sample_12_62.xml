<root BTCPP_format="2" schema_location="schemas/amiga_btcpp.xsd">
    <Mission>sample trees 12 and 62</Mission>
    <BehaviorTree ID="BT1">
        <Sequence name="MissionSequence">
            <!-- Enter column 12 -->
            <MoveToAisleHead name="EnterCol12" action_name="move_to_aisle_head" id="12"/>
            <!-- Critical actions for tree 12 -->
            <RetryUntilSuccessful name="SampleTree12" num_attempts="3">
                <Sequence name="Tree12Sequence">
                    <MoveToTreeID name="GoToTree12" action_name="follow_tree_id_waypoint" id="12" approach_tree="true"/>
                    <SampleLeaf name="Sample12" action_name="segment_leaves"/>
                </Sequence>
            </RetryUntilSuccessful>
            <!-- Exit column 12 -->
            <MoveToAisleHead name="ExitCol12" action_name="move_to_aisle_head" id="12"/>

            <!-- Enter column 8 (tree 62) -->
            <MoveToAisleHead name="EnterCol8" action_name="move_to_aisle_head" id="8"/>
            <!-- Critical actions for tree 62 -->
            <RetryUntilSuccessful name="SampleTree62" num_attempts="3">
                <Sequence name="Tree62Sequence">
                    <MoveToTreeID name="GoToTree62" action_name="follow_tree_id_waypoint" id="62" approach_tree="true"/>
                    <SampleLeaf name="Sample62" action_name="segment_leaves"/>
                </Sequence>
            </RetryUntilSuccessful>
            <!-- Exit column 8 -->
            <MoveToAisleHead name="ExitCol8" action_name="move_to_aisle_head" id="8"/>
        </Sequence>
    </BehaviorTree>
</root>
