<root BTCPP_format="4" schema_location="schemas/amiga_btcpp.xsd">
  <Mission>sample trees 58 and 64 in aisle 4</Mission>
  <BehaviorTree ID="SampleAisle4">
    <Sequence name="SampleAisle4Mission">
      <MoveToAisleHead name="EnterAisle4" action_name="move_to_aisle_head" id="4"/>
      <RetryUntilSuccessful name="SampleTree58WithRetry" num_attempts="3">
        <Sequence name="SampleTree58">
          <MoveToTreeID name="ApproachTree58" action_name="follow_tree_id_waypoint" id="58" approach_tree="true"/>
          <SampleLeaf name="SampleLeafTree58" action_name="segment_leaves"/>
        </Sequence>
      </RetryUntilSuccessful>
      <RetryUntilSuccessful name="SampleTree64WithRetry" num_attempts="3">
        <Sequence name="SampleTree64">
          <MoveToTreeID name="ApproachTree64" action_name="follow_tree_id_waypoint" id="64" approach_tree="true"/>
          <SampleLeaf name="SampleLeafTree64" action_name="segment_leaves"/>
        </Sequence>
      </RetryUntilSuccessful>
      <MoveToAisleHead name="ExitAisle4" action_name="move_to_aisle_head" id="4"/>
    </Sequence>
  </BehaviorTree>
</root>
