<root BTCPP_format="4" schema_location="schemas/amiga_btcpp.xsd">
  <Mission>harvest trees 58 and 64 in aisle 4</Mission>
  <BehaviorTree ID="HarvestAisle4">
    <Sequence name="HarvestAisle4Mission">
      <MoveToAisleHead name="EnterAisle4" action_name="move_to_aisle_head" id="4"/>
      <RetryUntilSuccessful name="HarvestTree58WithRetry" num_attempts="3">
        <Sequence name="HarvestTree58">
          <MoveToTreeID name="ApproachTree58" action_name="follow_tree_id_waypoint" id="58" approach_tree="true"/>
          <HarvestFruit name="HarvestFruitTree58" action_name="harvest_fruit"/>
        </Sequence>
      </RetryUntilSuccessful>
      <RetryUntilSuccessful name="HarvestTree64WithRetry" num_attempts="3">
        <Sequence name="HarvestTree64">
          <MoveToTreeID name="ApproachTree64" action_name="follow_tree_id_waypoint" id="64" approach_tree="true"/>
          <HarvestFruit name="HarvestFruitTree64" action_name="harvest_fruit"/>
        </Sequence>
      </RetryUntilSuccessful>
      <MoveToAisleHead name="ExitAisle4" action_name="move_to_aisle_head" id="4"/>
    </Sequence>
  </BehaviorTree>
</root>
