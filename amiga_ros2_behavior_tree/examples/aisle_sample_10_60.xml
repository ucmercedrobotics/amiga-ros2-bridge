<root BTCPP_format="2" schema_location="schemas/amiga_btcpp.xsd">
  <Mission>sample trees 10 and 60</Mission>
  <BehaviorTree ID="mission_1">
    <Sequence name="main_sequence">
      <!-- Enter column 10 -->
      <MoveToAisleHead name="enter_col_10" action_name="move_to_aisle_head" id="10"/>
      <!-- Sample tree 10 with retry -->
      <RetryUntilSuccessful name="retry_tree10" num_attempts="3">
        <Sequence name="seq_tree10">
          <MoveToTreeID name="move_to_tree10" action_name="follow_tree_id_waypoint" id="10" approach_tree="true"/>
          <SampleLeaf name="sample_tree10" action_name="segment_leaves"/>
        </Sequence>
      </RetryUntilSuccessful>
      <!-- Exit column 10 -->
      <MoveToAisleHead name="exit_col_10" action_name="move_to_aisle_head" id="10"/>
      <!-- Enter column 6 -->
      <MoveToAisleHead name="enter_col_6" action_name="move_to_aisle_head" id="6"/>
      <!-- Sample tree 60 with retry -->
      <RetryUntilSuccessful name="retry_tree60" num_attempts="3">
        <Sequence name="seq_tree60">
          <MoveToTreeID name="move_to_tree60" action_name="follow_tree_id_waypoint" id="60" approach_tree="true"/>
          <SampleLeaf name="sample_tree60" action_name="segment_leaves"/>
        </Sequence>
      </RetryUntilSuccessful>
      <!-- Exit column 6 -->
      <MoveToAisleHead name="exit_col_6" action_name="move_to_aisle_head" id="6"/>
    </Sequence>
  </BehaviorTree>
</root>
